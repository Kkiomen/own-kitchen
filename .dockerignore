# Rebuilt inside the image, and copying them in would be slower than building
# them — node_modules alone is larger than everything else here put together.
node_modules
vendor
public/build
public/hot

# The live database is **not** baked in on purpose: 49 MB of household data in
# an image layer, stale the moment it is built. `compose.yaml` mounts the
# project's `database/` directory read-only instead, and the first start copies
# it into the volume.
database/database.sqlite
database/database.sqlite-*
database/database.sqlite.bak-*

# Runtime state. The container keeps its own on a volume; the host's belongs to
# Herd, and the crawler's page cache in here is measured in gigabytes.
storage
.env
.env.backup

.git
.github
.idea
tests
.phpunit.result.cache
*.md
img*.png
